# inventory.tf — sinh ra ansible/inventory/hosts.ini (ở gốc repo) sau khi terraform apply
# File này bị gitignore; Ansible đọc nó để biết IP và SSH config của từng máy.
# path.module = terraform/environments/lab → lùi 3 cấp mới tới gốc repo.

resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../../../ansible/inventory/hosts.ini"
  file_permission = "0644"

  content = <<-EOT
    # Auto-generated by Terraform (environments/lab/inventory.tf)
    # DO NOT EDIT MANUALLY — chạy terraform apply để cập nhật

    [bastion]
    bastion-01 ansible_host=${module.bastion.public_ip}

    [private]
    web-app-db-01 ansible_host=${module.vm1.private_ip}
    backup-01     ansible_host=${module.vm2.private_ip}

    [web]
    web-app-db-01

    [backup]
    backup-01

    [all:vars]
    ansible_user=ubuntu
    ansible_ssh_private_key_file=${var.ssh_private_key_path}

    # Chỉ máy private mới đi qua Bastion; bastion-01 SSH thẳng.
    # Dùng ProxyCommand (thay ProxyJump) để truyền -i, không phụ thuộc ssh-agent.
    [private:vars]
    ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ProxyCommand="ssh -W %h:%p -q -o StrictHostKeyChecking=no -i ${var.ssh_private_key_path} ubuntu@${module.bastion.public_ip}"'
  EOT
}
