# {{ ansible_managed }}
# Chỉ cho thành viên tới IP VPN của Bastion — không bật IP forwarding,
# vào VM1/VM2 vẫn bằng SSH ProxyJump qua Bastion.

[Interface]
Address = {{ wireguard_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_server_private_key }}
{% for peer in wireguard_peers %}

[Peer]
# {{ peer.name }}
PublicKey = {{ peer.wireguard.public_key }}
AllowedIPs = {{ peer.wireguard.ip }}/32
{% endfor %}
