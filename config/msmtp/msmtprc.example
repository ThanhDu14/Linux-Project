# Copy to /etc/msmtprc; set owner root:root and mode 0600.
# Do not commit a real App Password. Supply it from Ansible Vault or another secret store.
defaults
auth           on
tls            on
tls_starttls   on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        /var/log/msmtp.log

account        gmail
host           smtp.gmail.com
port           587
from           alerts@example.com
user           alerts@example.com
password       REPLACE_WITH_SECRET_FROM_VAULT

account default : gmail
