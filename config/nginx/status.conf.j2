# {{ ansible_managed }}
# Nguồn: config/nginx/status.conf.j2 (Thành viên 2 sở hữu) — biến ở ansible/roles/nginx/defaults/main.yml

server {
    listen 80;
    server_name {{ nginx_status_domain }};

    return 301 https://{{ nginx_status_domain }}$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ nginx_status_domain }};

    ssl_certificate     {{ nginx_tls_cert }};
    ssl_certificate_key {{ nginx_tls_key }};

    root {{ nginx_status_root }};
    index index.html;

    # Ô "Trạng thái ứng dụng" trên trang gọi /health cùng tên miền → chuyển sang Flask (không cần CORS)
    location = /health {
        access_log off;
        proxy_pass http://{{ nginx_app_upstream }}/health;
        proxy_set_header Host {{ nginx_app_domain }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
