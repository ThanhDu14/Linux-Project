# {{ ansible_managed }}
# Nguồn: config/nginx/default.conf.j2 (Thành viên 2 sở hữu) — biến ở ansible/roles/nginx/defaults/main.yml
#
# Server mặc định: nhận request có Host không khớp vhost nào — health check của NLB (Host = IP target),
# bot quét theo IP. Chỉ trả lời /health, còn lại đóng kết nối (444) để không lộ vhost nào đang chạy.

server {
    listen 80 default_server;
    server_name _;

    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate     {{ nginx_tls_cert }};
    ssl_certificate_key {{ nginx_tls_key }};

    # NLB health check (HTTPS /health) → hỏi thẳng Flask: app hoặc DB chết → 502/503 → target unhealthy
    location = /health {
        access_log off;
        proxy_pass http://{{ nginx_app_upstream }}/health;
        proxy_set_header Host {{ nginx_app_domain }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 444;
    }
}
